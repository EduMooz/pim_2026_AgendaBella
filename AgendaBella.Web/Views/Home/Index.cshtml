@model HomeViewModel
@{
    ViewData["Title"] = "Página inicial";
    // Fotos do site antigo, usadas para ilustrar os cartões de serviço.
    string Foto(string nome, int i) =>
        nome.Contains("Pé", StringComparison.OrdinalIgnoreCase) ? "foto_pe.jpeg"
        : (i % 2 == 0 ? "foto_mao2.jpeg" : "foto_mao.jpeg");
}

<section class="hero">
    <h1>Erika Santana</h1>
    <p class="subtitulo">Especialista em manicure e nail design</p>
    <p class="descricao">Atendimento personalizado, esmaltação impecável e unhas que valorizam sua beleza.</p>
    <a asp-controller="Agendamento" asp-action="Index" class="btn btn-rosa">
        <i class="fa-regular fa-calendar-check me-2" aria-hidden="true"></i>Agende seu horário
    </a>
</section>

<section class="servicos">
    <h2>Serviços oferecidos</h2>
    <p>Valores e tempos atualizados em tempo real</p>

    @if (Model.Servicos.Count == 0)
    {
        <p class="text-muted">Nenhum serviço disponível no momento.</p>
    }
    else
    {
        <div class="row">
            @for (var i = 0; i < Model.Servicos.Count; i++)
            {
                var s = Model.Servicos[i];
                <div class="col-md-6 mb-4">
                    <div class="card-servico h-100">
                        <img src="~/img/@Foto(s.Nome, i)" class="img-fluid" alt="" />
                        <div class="texto-card">
                            <h3>@s.Nome</h3>
                            <p>@s.Descricao</p>
                            <span>@Formatos.Moeda(s.Preco) • @s.Duracao min</span>
                            <div class="mt-3">
                                <a asp-controller="Agendamento" asp-action="Index" asp-route-servico="@s.Id" class="btn btn-outline-rosa btn-sm">Agendar este serviço</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>

<section class="localizacao">
    <h2>Localização e contato</h2>
    <div class="container-localizacao">
        <div class="coluna-esquerda">
            <h3><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Endereço</h3>
            <p>Rua das Flores, 123 - Jardim Primavera<br />São Paulo - SP<br />CEP: 01234-567</p>

            <h3><i class="fa-solid fa-clock" aria-hidden="true"></i> Horário de atendimento</h3>
            <p>Segunda a sexta: 9h às 19h<br />Sábado: 9h às 17h<br />Domingo: fechado</p>
        </div>
        <div class="coluna-direita">
            <h3>Contato</h3>
            <div class="redes">
                <a href="https://wa.me/5516999999999" target="_blank" rel="noopener noreferrer" class="rede-link whatsapp" aria-label="WhatsApp">
                    <i class="fa-brands fa-whatsapp" aria-hidden="true"></i>
                </a>
                <a href="#" class="rede-link instagram" aria-label="Instagram">
                    <i class="fa-brands fa-instagram" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</section>
