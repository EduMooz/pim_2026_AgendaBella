@model List<ServicoDto>
@{
    ViewData["Title"] = "Serviços";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="titulo-admin h2 m-0"><i class="fa-solid fa-hand-sparkles" aria-hidden="true"></i> Serviços cadastrados</h1>
    <a asp-action="Criar" class="btn btn-rosa"><i class="fa-solid fa-plus" aria-hidden="true"></i> Novo serviço</a>
</div>

<div class="card-tabela">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <caption class="visually-hidden">Serviços cadastrados</caption>
            <thead><tr><th scope="col">Nome</th><th scope="col">Preço</th><th scope="col">Duração</th><th scope="col">Situação</th><th scope="col" class="text-center">Ações</th></tr></thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Nome</td>
                        <td>@Formatos.Moeda(s.Preco)</td>
                        <td>@s.Duracao min</td>
                        <td>@(s.Ativo ? "Ativo" : "Inativo")</td>
                        <td class="text-center botoes-acoes">
                            <a asp-action="Editar" asp-route-id="@s.Id" class="btn btn-sm btn-rosa">Editar</a>
                            <form asp-action="Excluir" asp-route-id="@s.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Excluir este serviço? Se já foi usado em agendamentos, ele será apenas desativado.');">
                                <button type="submit" class="btn btn-sm btn-outline-rosa"><i class="fa-solid fa-trash" aria-hidden="true"></i> Excluir</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
