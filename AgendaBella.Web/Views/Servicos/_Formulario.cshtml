@model ServicoSalvarDto
@* Partial view: campos do serviço, usados em Criar e Editar. *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Nome" class="form-label"></label>
    <input asp-for="Nome" class="form-control" placeholder="Ex.: Alongamento de unhas" />
    <span asp-validation-for="Nome" class="form-text-erro"></span>
</div>
<div class="mb-3">
    <label asp-for="Descricao" class="form-label"></label>
    <textarea asp-for="Descricao" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Descricao" class="form-text-erro"></span>
</div>
<div class="row">
    <div class="col-6 mb-3">
        <label asp-for="Preco" class="form-label"></label>
        <input asp-for="Preco" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="Preco" class="form-text-erro"></span>
    </div>
    <div class="col-6 mb-3">
        <label asp-for="Duracao" class="form-label"></label>
        <input asp-for="Duracao" type="number" min="5" step="5" class="form-control" />
        <span asp-validation-for="Duracao" class="form-text-erro"></span>
    </div>
</div>
<div class="form-check mb-4">
    <input asp-for="Ativo" class="form-check-input" />
    <label asp-for="Ativo" class="form-check-label">Disponível para agendamento</label>
</div>
