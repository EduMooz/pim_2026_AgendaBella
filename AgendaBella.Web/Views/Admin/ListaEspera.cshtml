@model List<ListaEsperaDto>
@{
    ViewData["Title"] = "Lista de espera";
}

<h1 class="titulo-admin h2 mb-4"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Lista de espera</h1>
<p>Quando uma vaga é liberada (cancelamento ou reagendamento), o banco muda a primeira da fila para <strong>Notificado</strong> automaticamente (trigger).</p>

@if (Model.Count == 0)
{
    <p class="text-muted">Ninguém na lista de espera.</p>
}
else
{
    <div class="card-tabela">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Clientes em lista de espera</caption>
                <thead><tr><th scope="col">Cliente</th><th scope="col">Serviço</th><th scope="col">Data desejada</th><th scope="col">Horário</th><th scope="col">Situação</th><th scope="col">Pedido em</th></tr></thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td>@l.ClienteNome</td>
                            <td>@l.ServicoNome</td>
                            <td>@Formatos.Data(l.DataDesejada)</td>
                            <td>@(l.HorarioDesejado ?? "Qualquer")</td>
                            <td><span class="badge-status @Formatos.ClasseStatus(l.Status)">@l.Status</span></td>
                            <td>@Formatos.DataHora(l.DataSolicitacao)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
