@model RelatorioViewModel
@{
    ViewData["Title"] = "Relatórios";
    var d = Model.Dados;
}

<h1 class="titulo-admin h2 mb-4"><i class="fa-solid fa-chart-pie" aria-hidden="true"></i> Relatórios e previsão</h1>

<form asp-action="Relatorios" method="get" class="d-flex flex-wrap align-items-end gap-2 mb-4">
    <div>
        <label for="inicio" class="form-label mb-1">De</label>
        <input id="inicio" name="inicio" type="date" value="@Model.Inicio.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div>
        <label for="fim" class="form-label mb-1">Até</label>
        <input id="fim" name="fim" type="date" value="@Model.Fim.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <button type="submit" class="btn btn-rosa">Gerar relatório</button>
</form>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

@if (d is not null)
{
    <div class="grade-resumo">
        <div class="card-resumo"><h2 class="h6">Agendamentos</h2><p>@d.TotalAgendamentos</p></div>
        <div class="card-resumo"><h2 class="h6">Concluídos</h2><p>@d.TotalConcluidos</p></div>
        <div class="card-resumo"><h2 class="h6">Faturamento</h2><p>@Formatos.Moeda(d.Faturamento)</p></div>
        <div class="card-resumo"><h2 class="h6">Taxa de cancelamento</h2><p>@Formatos.Numero(d.TaxaCancelamento)%</p></div>
        <div class="card-resumo"><h2 class="h6">Dia de maior movimento</h2><p style="font-size:1.4rem">@d.DiaDePico</p></div>
    </div>

    <h2 class="subtitulo-admin h4 mb-3">Desempenho por serviço</h2>
    <div class="card-tabela mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <caption class="visually-hidden">Resumo por serviço no período</caption>
                <thead><tr><th scope="col">Serviço</th><th scope="col" class="text-end">Agend.</th><th scope="col" class="text-end">Concluídos</th><th scope="col" class="text-end">Cancelados</th><th scope="col" class="text-end">Faturamento</th></tr></thead>
                <tbody>
                    @foreach (var s in d.Servicos)
                    {
                        <tr>
                            <td>@s.Servico</td>
                            <td class="text-end">@s.TotalAgendamentos</td>
                            <td class="text-end">@s.Concluidos</td>
                            <td class="text-end">@s.Cancelados</td>
                            <td class="text-end">@Formatos.Moeda(s.Faturamento)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-6">
            <h2 class="subtitulo-admin h4 mb-3">Movimento por dia da semana</h2>
            @{ var maxDia = Math.Max(1, d.DemandaPorDia.Select(x => x.Total).DefaultIfEmpty(0).Max()); }
            @foreach (var dia in d.DemandaPorDia)
            {
                <div class="mb-2">
                    <div class="d-flex justify-content-between"><span>@HorarioTrabalho.NomesDias[dia.DiaSemana]</span><strong>@dia.Total</strong></div>
                    <div class="barra" role="img" aria-label="@HorarioTrabalho.NomesDias[dia.DiaSemana]: @dia.Total agendamentos"><span style="width:@((dia.Total * 100 / maxDia))%"></span></div>
                </div>
            }
            @if (d.DemandaPorDia.Count == 0) { <p class="text-muted">Sem dados no período.</p> }
        </div>

        <div class="col-12 col-lg-6">
            <h2 class="subtitulo-admin h4 mb-3">Previsão de demanda</h2>
            <div class="previsao">
                @if (d.Previsao.DadosSuficientes)
                {
                    <div class="numero">@d.Previsao.PrevisaoProximaSemana</div>
                    <div>agendamentos previstos na próxima semana</div>
                    <p class="mt-3 mb-1"><strong>Tendência:</strong> @d.Previsao.Tendencia
                        (@(d.Previsao.Inclinacao >= 0 ? "+" : "")@Formatos.Numero(d.Previsao.Inclinacao, 2) por semana)</p>
                    <p class="small mb-0">Ajuste da reta (R²): @Formatos.Numero(d.Previsao.R2, 2). Calculado por regressão linear sobre as últimas @d.Previsao.SemanasAnalisadas semanas completas.</p>
                }
                else
                {
                    <p class="mb-0">Ainda não há semanas suficientes para prever (mínimo de 4 semanas completas).</p>
                }
            </div>

            @{ var maxSem = Math.Max(1, d.DemandaSemanal.Select(x => x.Total).DefaultIfEmpty(0).Max()); }
            <h3 class="h6 mt-4">Agendamentos por semana (início na segunda-feira)</h3>
            @foreach (var w in d.DemandaSemanal)
            {
                <div class="mb-2">
                    <div class="d-flex justify-content-between"><span>@w.InicioSemana.ToString("dd/MM")</span><strong>@w.Total</strong></div>
                    <div class="barra" role="img" aria-label="Semana de @w.InicioSemana.ToString("dd/MM"): @w.Total agendamentos"><span style="width:@((w.Total * 100 / maxSem))%"></span></div>
                </div>
            }
        </div>
    </div>
}
